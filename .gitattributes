# B14-10: preserve checksum-bearing session artifacts across Windows checkout.
results/b14_10/** -text
analysis/b14_10/** text eol=lf
# JSON written on Windows retains CRLF bytes; CR is not trailing whitespace.
results/b14_10/** whitespace=cr-at-eol
# B16/B17 slot 05: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b16_05/** -text whitespace=cr-at-eol
delivery/b16_05/** -text whitespace=cr-at-eol
results/logs/b16_05_* -text whitespace=cr-at-eol
results/b17_05/** -text whitespace=cr-at-eol
delivery/b17_05/** -text whitespace=cr-at-eol
results/logs/b17_05_* -text whitespace=cr-at-eol
docs/b16_05_* text eol=lf
analysis/b16_05_* text eol=lf
docs/b17_05_* text eol=lf
analysis/b17_05_* text eol=lf
# B18 slot 05: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b18_05/** -text whitespace=cr-at-eol
delivery/b18_05/** -text whitespace=cr-at-eol
results/logs/b18_05_* -text whitespace=cr-at-eol
docs/b18_05_* text eol=lf
