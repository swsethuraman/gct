# B14-10: preserve checksum-bearing session artifacts across Windows checkout.
results/b14_10/** -text
analysis/b14_10/** text eol=lf
# JSON written on Windows retains CRLF bytes; CR is not trailing whitespace.
results/b14_10/** whitespace=cr-at-eol
# B16/B17 slot 07: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b16_07/** -text whitespace=cr-at-eol
delivery/b16_07/** -text whitespace=cr-at-eol
results/logs/b16_07_* -text whitespace=cr-at-eol
results/b17_07/** -text whitespace=cr-at-eol
delivery/b17_07/** -text whitespace=cr-at-eol
results/logs/b17_07_* -text whitespace=cr-at-eol
docs/b16_07_* text eol=lf
analysis/b16_07_* text eol=lf
docs/b17_07_* text eol=lf
analysis/b17_07_* text eol=lf
# B19 slot 07: manifest SHA256 values bind the bytes as written on disk (CRLF included).
docs/b19_07_* -text whitespace=cr-at-eol
analysis/b19_07_* -text whitespace=cr-at-eol
analysis/integrate/b19_07_* -text whitespace=cr-at-eol
results/b19_07/** -text whitespace=cr-at-eol
results/b19_07_*/** -text whitespace=cr-at-eol
results/logs/b19_07_* -text whitespace=cr-at-eol
delivery/b19_07/** -text whitespace=cr-at-eol
