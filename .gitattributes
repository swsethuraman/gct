# B14-10: preserve checksum-bearing session artifacts across Windows checkout.
results/b14_10/** -text
analysis/b14_10/** text eol=lf
# JSON written on Windows retains CRLF bytes; CR is not trailing whitespace.
results/b14_10/** whitespace=cr-at-eol
# B16/B17 slot 12: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b16_12/** -text whitespace=cr-at-eol
delivery/b16_12/** -text whitespace=cr-at-eol
results/logs/b16_12_* -text whitespace=cr-at-eol
results/b17_12/** -text whitespace=cr-at-eol
delivery/b17_12/** -text whitespace=cr-at-eol
results/logs/b17_12_* -text whitespace=cr-at-eol
docs/b16_12_* text eol=lf
analysis/b16_12_* text eol=lf
docs/b17_12_* text eol=lf
analysis/b17_12_* text eol=lf
