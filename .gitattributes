# B14-10: preserve checksum-bearing session artifacts across Windows checkout.
results/b14_10/** -text
analysis/b14_10/** text eol=lf
# JSON written on Windows retains CRLF bytes; CR is not trailing whitespace.
results/b14_10/** whitespace=cr-at-eol
# B16/B17 slot 10: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b16_10/** -text whitespace=cr-at-eol
delivery/b16_10/** -text whitespace=cr-at-eol
results/logs/b16_10_* -text whitespace=cr-at-eol
docs/b16_10_* text eol=lf
analysis/b16_10_* text eol=lf
# B18 slot 10: manifest SHA256 values bind the bytes as written on disk (CRLF included).
results/b18_10/** -text whitespace=cr-at-eol
delivery/b18_10/** -text whitespace=cr-at-eol
results/logs/b18_10_* -text whitespace=cr-at-eol
docs/b18_10_* -text whitespace=cr-at-eol
analysis/b18_10_* -text whitespace=cr-at-eol
# B18 slot 10: sibling results directories and integrator reproductions.
results/b18_10_*/** -text whitespace=cr-at-eol
analysis/integrate/b18_10_* -text whitespace=cr-at-eol
