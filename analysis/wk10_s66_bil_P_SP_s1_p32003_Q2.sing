// Session 66 : reduced bilinear system Q2 at a P_SP point; alpha=2, beta=8
LIB "primdec.lib";
ring r = 32003, (a(1..2), b(1..8)), dp;
option(redSB);
ideal I = (-10698)*a(2)*b(5) + (7242)*a(2)*b(6) + (12924)*a(2)*b(7) + (11370)*a(2)*b(8),
  (10299)*a(2)*b(5) + (-12679)*a(2)*b(6) + (-1887)*a(2)*b(7) + (11950)*a(2)*b(8),
  (-14662)*a(2)*b(5) + (-7618)*a(2)*b(6) + (548)*a(2)*b(7) + (-5351)*a(2)*b(8),
  (4600)*a(2)*b(5) + (-4988)*a(2)*b(6) + (15090)*a(2)*b(7) + (3449)*a(2)*b(8),
  (-10698)*a(1)*b(5) + (7242)*a(1)*b(6) + (12924)*a(1)*b(7) + (11370)*a(1)*b(8) + (-10698)*a(2)*b(1) + (7242)*a(2)*b(2) + (12924)*a(2)*b(3) + (11370)*a(2)*b(4),
  (10299)*a(1)*b(5) + (-12679)*a(1)*b(6) + (-1887)*a(1)*b(7) + (11950)*a(1)*b(8) + (10299)*a(2)*b(1) + (-12679)*a(2)*b(2) + (-1887)*a(2)*b(3) + (11950)*a(2)*b(4),
  (-14662)*a(1)*b(5) + (-7618)*a(1)*b(6) + (548)*a(1)*b(7) + (-5351)*a(1)*b(8) + (-14662)*a(2)*b(1) + (-7618)*a(2)*b(2) + (548)*a(2)*b(3) + (-5351)*a(2)*b(4),
  (4600)*a(1)*b(5) + (-4988)*a(1)*b(6) + (15090)*a(1)*b(7) + (3449)*a(1)*b(8) + (4600)*a(2)*b(1) + (-4988)*a(2)*b(2) + (15090)*a(2)*b(3) + (3449)*a(2)*b(4),
  (-10698)*a(1)*b(1) + (7242)*a(1)*b(2) + (12924)*a(1)*b(3) + (11370)*a(1)*b(4),
  (10299)*a(1)*b(1) + (-12679)*a(1)*b(2) + (-1887)*a(1)*b(3) + (11950)*a(1)*b(4),
  (-14662)*a(1)*b(1) + (-7618)*a(1)*b(2) + (548)*a(1)*b(3) + (-5351)*a(1)*b(4),
  (4600)*a(1)*b(1) + (-4988)*a(1)*b(2) + (15090)*a(1)*b(3) + (3449)*a(1)*b(4);
int t0 = timer;
ideal G = std(I);
print("Q2: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Q2: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_bilprimes_P_SP_s1_p32003_Q2.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin));
  write(":a results/s66_bilprimes_P_SP_s1_p32003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_bilprimes_P_SP_s1_p32003_Q2.txt", string(Pi));
  kill islin;
}
quit;
