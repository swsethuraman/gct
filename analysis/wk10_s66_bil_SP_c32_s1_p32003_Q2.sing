  (3288)*a(1)*b(1) + (12214)*a(1)*b(2) + (8567)*a(1)*b(3) + (14539)*a(1)*b(7) + (-5704)*a(1)*b(8) + (2061)*a(1)*b(9) + (7172)*a(1)*b(10) + (-4932)*a(2)*b(1) + (13682)*a(2)*b(2) + (3151)*a(2)*b(3) + (-5807)*a(2)*b(7) + (8556)*a(2)*b(8) + (12910)*a(2)*b(9) + (-10758)*a(2)*b(10),
