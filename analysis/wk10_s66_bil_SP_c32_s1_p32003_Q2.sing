// Session 66 : reduced bilinear system Q2 at a SP_c32 point; alpha=2, beta=10
LIB "primdec.lib";
ring r = 32003, (a(1..2), b(1..10)), dp;
option(redSB);
ideal I = (764)*a(1)*b(7) + (-5326)*a(2)*b(7),
  (-3541)*a(1)*b(7) + (9948)*a(1)*b(8) + (10992)*a(1)*b(9) + (-14499)*a(1)*b(10) + (-317)*a(2)*b(7) + (-652)*a(2)*b(8) + (10166)*a(2)*b(9) + (-13951)*a(2)*b(10),
