  (13501)*a(1)*b(1) + (1831)*a(1)*b(2) + (14748)*a(1)*b(3) + (-6635)*a(1)*b(4) + (11469)*a(1)*b(5) + (6804)*a(1)*b(6) + (9797)*a(1)*b(7) + (11250)*a(1)*b(8) + (13859)*a(1)*b(9) + (11495)*a(1)*b(10) + (-4250)*a(2)*b(1) + (13255)*a(2)*b(2) + (9881)*a(2)*b(3) + (-6049)*a(2)*b(4) + (-1202)*a(2)*b(5) + (-10206)*a(2)*b(6) + (1306)*a(2)*b(7) + (15128)*a(2)*b(8) + (-4787)*a(2)*b(9) + (-1241)*a(2)*b(10),
  (-4798)*a(1)*b(1) + (906)*a(1)*b(2) + (-2814)*a(1)*b(3) + (-10321)*a(1)*b(4) + (-68)*a(1)*b(5) + (-13035)*a(1)*b(6) + (-13754)*a(1)*b(7) + (-14645)*a(1)*b(8) + (-4290)*a(1)*b(9) + (4498)*a(1)*b(10) + (7197)*a(2)*b(1) + (-1359)*a(2)*b(2) + (4221)*a(2)*b(3) + (-520)*a(2)*b(4) + (102)*a(2)*b(5) + (3551)*a(2)*b(6) + (-11372)*a(2)*b(7) + (5966)*a(2)*b(8) + (6435)*a(2)*b(9) + (-6747)*a(2)*b(10);
int t0 = timer;
ideal G = std(I);
print("Q2: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Q2: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_bilprimes_SP_c32_s1_p32003_Q2.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin));
  write(":a results/s66_bilprimes_SP_c32_s1_p32003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_bilprimes_SP_c32_s1_p32003_Q2.txt", string(Pi));
  kill islin;
}
quit;
