  (-4798)*a(1)*b(4) + (906)*a(1)*b(5) + (-2814)*a(1)*b(6) + (-7119)*a(1)*b(7) + (8756)*a(1)*b(8) + (12327)*a(1)*b(9) + (15583)*a(1)*b(10) + (7197)*a(2)*b(4) + (-1359)*a(2)*b(5) + (4221)*a(2)*b(6) + (-5323)*a(2)*b(7) + (-13134)*a(2)*b(8) + (-2489)*a(2)*b(9) + (-7373)*a(2)*b(10),
