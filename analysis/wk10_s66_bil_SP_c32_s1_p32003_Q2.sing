  (3288)*a(1)*b(4) + (12214)*a(1)*b(5) + (8567)*a(1)*b(6) + (4837)*a(1)*b(7) + (-8506)*a(1)*b(8) + (-180)*a(1)*b(9) + (12087)*a(1)*b(10) + (-4932)*a(2)*b(4) + (13682)*a(2)*b(5) + (3151)*a(2)*b(6) + (8746)*a(2)*b(7) + (12759)*a(2)*b(8) + (270)*a(2)*b(9) + (-2129)*a(2)*b(10),
  (-11311)*a(1)*b(4) + (365)*a(1)*b(5) + (-5721)*a(1)*b(6) + (12781)*a(1)*b(7) + (-2544)*a(1)*b(8) + (3736)*a(1)*b(9) + (15912)*a(1)*b(10) + (8883)*a(2)*b(4) + (-4027)*a(2)*b(5) + (-3294)*a(2)*b(6) + (-3381)*a(2)*b(7) + (-3095)*a(2)*b(8) + (-4461)*a(2)*b(9) + (1206)*a(2)*b(10),
