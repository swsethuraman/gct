// Session 66 : reduced bilinear system Qpi at a SP_c32 point; alpha=2, beta=10
LIB "primdec.lib";
ring r = 32003, (a(1..2), b(1..10)), dp;
option(redSB);
ideal I = (1302)*a(1)*b(7) + (-15852)*a(1)*b(8) + (-9533)*a(1)*b(9) + (-7667)*a(1)*b(10) + (-10570)*a(2)*b(7) + (-13774)*a(2)*b(8) + (-2788)*a(2)*b(9) + (-15872)*a(2)*b(10),
