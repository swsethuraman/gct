  (-6532)*a(1)*b(1) + (15896)*a(1)*b(2) + (6624)*a(1)*b(3) + (-13192)*a(1)*b(4) + (-13803)*a(1)*b(5) + (-4325)*a(1)*b(6) + (889)*a(1)*b(7) + (-2786)*a(1)*b(8) + (-10732)*a(1)*b(9) + (-14667)*a(1)*b(10) + (7800)*a(2)*b(1) + (-14362)*a(2)*b(2) + (11094)*a(2)*b(3) + (917)*a(2)*b(4) + (-5272)*a(2)*b(5) + (-15057)*a(2)*b(6) + (1543)*a(2)*b(7) + (10218)*a(2)*b(8) + (-10986)*a(2)*b(9) + (-10382)*a(2)*b(10),
  (12461)*a(1)*b(1) + (-12949)*a(1)*b(2) + (-12274)*a(1)*b(3) + (-9316)*a(1)*b(4) + (13722)*a(1)*b(5) + (-4121)*a(1)*b(6) + (-15641)*a(1)*b(7) + (12987)*a(1)*b(8) + (-15066)*a(1)*b(9) + (-9897)*a(1)*b(10) + (-10776)*a(2)*b(1) + (-7278)*a(2)*b(2) + (12579)*a(2)*b(3) + (-8360)*a(2)*b(4) + (-2554)*a(2)*b(5) + (15031)*a(2)*b(6) + (15370)*a(2)*b(7) + (12094)*a(2)*b(8) + (7394)*a(2)*b(9) + (-12935)*a(2)*b(10),
