int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin));
  write(":a results/s66_bilprimes_c21_c32_s1_p32003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_bilprimes_c21_c32_s1_p32003_Q2.txt", string(Pi));
  kill islin;
}
quit;
