// Session 66 : reduced bilinear system Q2 at a ker_c21 point; alpha=10, beta=4
LIB "primdec.lib";
ring r = 32003, (a(1..10), b(1..4)), dp;
option(redSB);
ideal I = (1386)*a(10)*b(4),
  (1386)*a(7)*b(4) + (11326)*a(8)*b(4) + (7064)*a(9)*b(4) + (1386)*a(10)*b(3) + (4629)*a(10)*b(4),
