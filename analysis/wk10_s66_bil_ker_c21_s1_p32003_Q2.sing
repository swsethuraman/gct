  (15168)*a(1)*b(1) + (10063)*a(1)*b(4) + (-15518)*a(2)*b(1) + (-5606)*a(2)*b(4) + (-14138)*a(3)*b(1) + (1030)*a(3)*b(4) + (10063)*a(10)*b(1) + (-870)*a(10)*b(4),
  (-1993)*a(1)*b(1) + (4644)*a(1)*b(4) + (-14179)*a(2)*b(1) + (6023)*a(2)*b(4) + (-15975)*a(3)*b(1) + (-757)*a(3)*b(4) + (4644)*a(10)*b(1) + (-705)*a(10)*b(4);
int t0 = timer;
ideal G = std(I);
print("Q2: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Q2: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_bilprimes_ker_c21_s1_p32003_Q2.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin));
  write(":a results/s66_bilprimes_ker_c21_s1_p32003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_bilprimes_ker_c21_s1_p32003_Q2.txt", string(Pi));
  kill islin;
}
quit;
