for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1; int j;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  string eq = "";
  if (size(reduce(L_c21, Pi)) == 0 && size(reduce(Pi, std(L_c21))) == 0) { eq = eq + " =T_c21"; }
