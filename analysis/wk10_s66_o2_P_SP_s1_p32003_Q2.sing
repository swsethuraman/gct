list mp = minAssGTZ(I);
print("Q2: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_primes_P_SP_s1_p32003_Q2.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  string eq = "";
  if (size(reduce(L_P, Pi)) == 0 && size(reduce(Pi, std(L_P))) == 0) { eq = eq + " =T_P"; }
  if (size(reduce(L_SP, Pi)) == 0 && size(reduce(Pi, std(L_SP))) == 0) { eq = eq + " =T_SP"; }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin) + eq);
  write(":a results/s66_primes_P_SP_s1_p32003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_primes_P_SP_s1_p32003_Q2.txt", string(Pi));
  kill islin; kill eq;
}
quit;
