int t0 = timer;
ideal G = std(I);
print("Qpi: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Qpi: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_redprimes_P_c21_s1_p32003_Qpi.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  string eq = "";
  if (size(reduce(L_P, Pi)) == 0 && size(reduce(Pi, std(L_P))) == 0) { eq = eq + " =T_P"; }
  if (size(reduce(L_c21, Pi)) == 0 && size(reduce(Pi, std(L_c21))) == 0) { eq = eq + " =T_c21"; }
  if (size(reduce(L_SP0, Pi)) == 0 && size(reduce(Pi, std(L_SP0))) == 0) { eq = eq + " =T_SP0"; }
  if (size(reduce(L_SP1, Pi)) == 0 && size(reduce(Pi, std(L_SP1))) == 0) { eq = eq + " =T_SP1"; }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin) + eq);
  write(":a results/s66_redprimes_P_c21_s1_p32003_Qpi.txt", "PRIME " + string(i));
  write(":a results/s66_redprimes_P_c21_s1_p32003_Qpi.txt", string(Pi));
  kill islin; kill eq;
}
quit;
