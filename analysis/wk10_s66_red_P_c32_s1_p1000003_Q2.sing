  (-308865)*w(1) + (94651)*w(2) + (1)*w(18),
  (144047)*w(1) + (-183285)*w(2) + (1)*w(19),
  (281702)*w(1) + (458424)*w(2) + (1)*w(20),
  (1)*w(22);
ideal L_SP = (-35983)*w(4) + (1)*w(5),
  (-83999)*w(2) + (-375404)*w(4) + (1)*w(6),
  (133898)*w(4) + (1)*w(8),
  (-257583)*w(4) + (1)*w(12),
  (418718)*w(4) + (1)*w(13),
  (-398441)*w(4) + (-83999)*w(10) + (1)*w(14),
  (-254936)*w(4) + (1)*w(16),
  (-435858)*w(4) + (1)*w(17),
  (125725)*w(4) + (1)*w(18),
  (-50897)*w(4) + (1)*w(19),
  (-275548)*w(4) + (1)*w(20),
  (1)*w(22);
ideal L_c32 = (-350494)*w(2) + (-257583)*w(6) + (-83999)*w(10) + (1)*w(14),
  (125725)*w(2) + (141953)*w(6) + (1)*w(17),
  (-17692)*w(2) + (142419)*w(6) + (1)*w(21),
  (-2909)*w(2) + (451352)*w(6) + (1)*w(22);
int t0 = timer;
ideal G = std(I);
print("Q2: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Q2: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_redprimes_P_c32_s1_p1000003_Q2.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  string eq = "";
  if (size(reduce(L_P, Pi)) == 0 && size(reduce(Pi, std(L_P))) == 0) { eq = eq + " =T_P"; }
  if (size(reduce(L_SP, Pi)) == 0 && size(reduce(Pi, std(L_SP))) == 0) { eq = eq + " =T_SP"; }
  if (size(reduce(L_c32, Pi)) == 0 && size(reduce(Pi, std(L_c32))) == 0) { eq = eq + " =T_c32"; }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin) + eq);
  write(":a results/s66_redprimes_P_c32_s1_p1000003_Q2.txt", "PRIME " + string(i));
  write(":a results/s66_redprimes_P_c32_s1_p1000003_Q2.txt", string(Pi));
  kill islin; kill eq;
}
quit;
