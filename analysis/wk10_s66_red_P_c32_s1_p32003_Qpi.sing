  (1)*w(22);
ideal L_c32 = (7434)*w(2) + (-10132)*w(6) + (-2117)*w(10) + (1)*w(14),
  (-2947)*w(2) + (-2372)*w(6) + (1)*w(17),
  (1321)*w(2) + (14920)*w(6) + (1)*w(21),
  (-13250)*w(2) + (14942)*w(6) + (1)*w(22);
int t0 = timer;
ideal G = std(I);
print("Qpi: dim V = " + string(dim(G)) + ", time " + string(timer - t0));
t0 = timer;
list mp = minAssGTZ(I);
print("Qpi: " + string(size(mp)) + " minimal primes, time " + string(timer - t0));
write(":w results/s66_redprimes_P_c32_s1_p32003_Qpi.txt", "");
int i; int j;
for (i = 1; i <= size(mp); i++) {
  ideal Pi = std(mp[i]);
  int islin = 1;
  for (j = 1; j <= size(Pi); j++) { if (deg(Pi[j]) > 1) { islin = 0; } }
  string eq = "";
  if (size(reduce(L_P, Pi)) == 0 && size(reduce(Pi, std(L_P))) == 0) { eq = eq + " =T_P"; }
  if (size(reduce(L_SP, Pi)) == 0 && size(reduce(Pi, std(L_SP))) == 0) { eq = eq + " =T_SP"; }
  if (size(reduce(L_c32, Pi)) == 0 && size(reduce(Pi, std(L_c32))) == 0) { eq = eq + " =T_c32"; }
  print("  prime " + string(i) + ": dim " + string(dim(Pi)) + ", degree " + string(mult(Pi)) + ", ngens " + string(size(Pi)) + ", linear " + string(islin) + eq);
  write(":a results/s66_redprimes_P_c32_s1_p32003_Qpi.txt", "PRIME " + string(i));
  write(":a results/s66_redprimes_P_c32_s1_p32003_Qpi.txt", string(Pi));
  kill islin; kill eq;
}
quit;
