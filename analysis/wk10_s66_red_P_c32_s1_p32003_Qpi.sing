ideal L_SP = (1602)*w(4) + (1)*w(5),
  (-2117)*w(2) + (8535)*w(4) + (1)*w(6),
  (-3083)*w(4) + (1)*w(8),
  (-10132)*w(4) + (1)*w(12),
