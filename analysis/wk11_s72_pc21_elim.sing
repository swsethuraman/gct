for(i=1;i<=size(mp);i++){ideal Pi=std(mp[i]);int isl=1;for(j=1;j<=size(Pi);j++){if(deg(Pi[j])>1){isl=0;}}print("  prime "+string(i)+": dim "+string(dim(Pi))+" deg "+string(mult(Pi))+" ngens "+string(size(Pi))+" linear "+string(isl));kill isl;}
quit;
