{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gct:b15-evidence:1",
  "title": "B15 evidence observation contract",
  "description": "This schema describes observations, not authority. Runtime validation additionally checks the partition sum/order, supported context and point family. All observations remain RECORDED; only pinned inherited sources or native replay may change bounds.",
  "type": "object",
  "required": ["schema", "cell", "producer_model", "source", "status", "raw", "raw_sha256", "usable_for_bounds"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "b15-evidence/1"},
    "producer_model": {"enum": ["gpt-6-astra", "claude-opus-5"]},
    "source": {"type": "string", "minLength": 1},
    "status": {"const": "RECORDED"},
    "raw": {},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "usable_for_bounds": {"const": false},
    "cell": {
      "type": "object",
      "required": ["n", "delta", "ell", "lambda", "ambient_variables", "representation", "geometry", "context", "point_family"],
      "additionalProperties": false,
      "properties": {
        "n": {"enum": [3, 4]},
        "delta": {"type": "integer", "minimum": 1},
        "ell": {"type": "integer", "minimum": 1},
        "lambda": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "ambient_variables": {"enum": [9, 16]},
        "representation": {"const": "polynomial_GL_covariant_Schur_label"},
        "geometry": {"const": "orbit_closure"},
        "context": {"enum": ["quartic_padded_gap", "cubic_per3_ideal"]},
        "point_family": {"enum": ["det4_vs_independent_z_per3", "per3"]}
      }
    }
  }
}
