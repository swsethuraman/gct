poly ellB = (-20)*t(0)+(24)*t(1)+(75)*t(2)+(17)*t(3)+(-96)*t(4)+(82)*t(5)+(-20)*t(6)+(18)*t(7)+(-75)*t(8);
poly g = (77)*Jt[1]+(-85)*Jt[2]+(34)*Jt[3]+(-64)*Jt[4]+(-45)*Jt[5]+(75)*Jt[6]+(68)*Jt[7]+(8)*Jt[8]+(63)*Jt[9];
int rt1 = rtimer;
int rt2;
int rt3;
int degE = -1;
int dimE = -2;
int degp_g = -1;
int dim_g = -2;
int degr = -1;
int vdB = -1;
ideal E = std(Jt);
dimE = dim(E); if (dimE >= 1) { degE = mult(E); }
print("EXCESS k=7 dim=" + string(dimE) + " deg=" + string(degE));
ideal Is = polar_sat(G, Jt, C, 7);
list L = list(dim(Is), 0, -1);
if (L[1] >= 0) { L[2] = mult(Is); }
if (L[1] == 1) { L[3] = vdim(std(Is + (ellA - 1))); vdB = vdim(std(Is + (ellB - 1))); }
if (L[1] == -1) { L[3] = 0; vdB = 0; }
rt2 = rtimer;
print("COUNT form=per3 p=2147483629 seed=61 k=7 dim=" + string(L[1]) + " degp=" + string(L[2]) + " vdA=" + string(L[3]) + " vdB=" + string(vdB) + " excess_dim=" + string(dimE) + " excess_deg=" + string(degE) + " sec=" + string(rt2 - rt1));
list Lg = polar_count_g(G, Jt, C, ellA, g, 7);
print("COUNTG form=per3 p=2147483629 seed=61 k=7 dim=" + string(Lg[1]) + " degp=" + string(Lg[2]));
kill S7;
setring R;
print("DONE form=per3 p=2147483629 seed=61 total_sec=" + string(rtimer - rt0));
