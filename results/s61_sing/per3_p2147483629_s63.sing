poly ellB = (0)*t(0)+(37)*t(1)+(-76)*t(2)+(91)*t(3)+(58)*t(4)+(47)*t(5)+(37)*t(6)+(87)*t(7)+(69)*t(8);
poly g = (-75)*Jt[1]+(-83)*Jt[2]+(87)*Jt[3]+(-19)*Jt[4]+(-85)*Jt[5]+(69)*Jt[6]+(22)*Jt[7]+(4)*Jt[8]+(44)*Jt[9];
