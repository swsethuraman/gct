poly ellB = (-78)*t(0)+(31)*t(1)+(-63)*t(2)+(-42)*t(3)+(73)*t(4)+(-55)*t(5)+(-69)*t(6)+(-66)*t(7)+(-90)*t(8);
poly g = (-49)*Jt[1]+(79)*Jt[2]+(-92)*Jt[3]+(25)*Jt[4]+(-7)*Jt[5]+(64)*Jt[6]+(-65)*Jt[7]+(-94)*Jt[8]+(8)*Jt[9];
int rt1 = rtimer;
int rt2;
int rt3;
int degE = -1;
int dimE = -2;
int degp_g = -1;
int dim_g = -2;
int degr = -1;
int vdB = -1;
ideal E = std(Jt);
dimE = dim(E); if (dimE >= 1) { degE = mult(E); }
print("EXCESS k=7 dim=" + string(dimE) + " deg=" + string(degE));
ideal Is = polar_sat(G, Jt, C, 7);
list L = list(dim(Is), 0, -1);
if (L[1] >= 0) { L[2] = mult(Is); }
if (L[1] == 1) { L[3] = vdim(std(Is + (ellA - 1))); vdB = vdim(std(Is + (ellB - 1))); }
if (L[1] == -1) { L[3] = 0; vdB = 0; }
rt2 = rtimer;
print("COUNT form=per3 p=2147483647 seed=61 k=7 dim=" + string(L[1]) + " degp=" + string(L[2]) + " vdA=" + string(L[3]) + " vdB=" + string(vdB) + " excess_dim=" + string(dimE) + " excess_deg=" + string(degE) + " sec=" + string(rt2 - rt1));
list Lg = polar_count_g(G, Jt, C, ellA, g, 7);
print("COUNTG form=per3 p=2147483647 seed=61 k=7 dim=" + string(Lg[1]) + " degp=" + string(Lg[2]));
kill S7;
setring R;
print("DONE form=per3 p=2147483647 seed=61 total_sec=" + string(rtimer - rt0));
quit;
