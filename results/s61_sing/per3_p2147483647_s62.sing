poly ellB = (42)*t(0)+(16)*t(1)+(82)*t(2)+(29)*t(3)+(-34)*t(4)+(-55)*t(5)+(-38)*t(6)+(22)*t(7)+(-76)*t(8);
poly g = (16)*Jt[1]+(94)*Jt[2]+(49)*Jt[3]+(18)*Jt[4]+(-11)*Jt[5]+(-86)*Jt[6]+(57)*Jt[7]+(-53)*Jt[8]+(-42)*Jt[9];
int rt1 = rtimer;
int rt2;
int rt3;
int degE = -1;
int dimE = -2;
int degp_g = -1;
int dim_g = -2;
int degr = -1;
int vdB = -1;
ideal E = std(Jt);
dimE = dim(E); if (dimE >= 1) { degE = mult(E); }
print("EXCESS k=7 dim=" + string(dimE) + " deg=" + string(degE));
ideal Is = polar_sat(G, Jt, C, 7);
list L = list(dim(Is), 0, -1);
if (L[1] >= 0) { L[2] = mult(Is); }
if (L[1] == 1) { L[3] = vdim(std(Is + (ellA - 1))); vdB = vdim(std(Is + (ellB - 1))); }
if (L[1] == -1) { L[3] = 0; vdB = 0; }
rt2 = rtimer;
print("COUNT form=per3 p=2147483647 seed=62 k=7 dim=" + string(L[1]) + " degp=" + string(L[2]) + " vdA=" + string(L[3]) + " vdB=" + string(vdB) + " excess_dim=" + string(dimE) + " excess_deg=" + string(degE) + " sec=" + string(rt2 - rt1));
list Lg = polar_count_g(G, Jt, C, ellA, g, 7);
print("COUNTG form=per3 p=2147483647 seed=62 k=7 dim=" + string(Lg[1]) + " degp=" + string(Lg[2]));
kill S7;
setring R;
print("DONE form=per3 p=2147483647 seed=62 total_sec=" + string(rtimer - rt0));
quit;
